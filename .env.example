PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=123456789
PGDATABASE=rmp_motos
PGMAINTDB=postgres
PORT=8787
ADMIN_API_KEY=rmp-local-admin-key
VITE_ADMIN_API_KEY=rmp-local-admin-key
JWT_SECRET=change_this_to_a_strong_secret
# API (sin barra final). Vacío en local = Vite enruta /api al proxy (puerto 8787).
# En Vercel: obligatorio — p. ej. https://tu-api.railway.app (y en el backend ALLOWED_ORIGINS con tu URL de Vercel).
VITE_API_BASE=
# Vercel (middleware): URL del API Node en Railway/Render (sin barra). No es VITE_; solo servidor en deploy.
# API_PROXY_TARGET=https://tu-api.railway.app
# Orígenes del navegador permitidos para CORS (coma, sin espacios obligatorios). En producción es obligatorio al menos uno.
# ALLOWED_ORIGINS=https://tu-dominio.vercel.app,http://localhost:5173
